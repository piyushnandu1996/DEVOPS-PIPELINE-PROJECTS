pipeline{
    agent any
    stages{
        stage("Git pull"){
            steps{
                git branch: 'main', url: 'https://github.com/piyushnandu1996/DEVOPS-PIPELINE-PROJECTS.git'
            }
        }

        stage("Installing maven package"){
            steps{
            sh '''
                if ! command mvn -v ; then
                    sudo apt install -y maven
                fi
               '''
            }
        }

        stage("Building java project "){
            steps{
                dir("java-maven-tomcat-pipeline/java-project/DemoApp/"){
                    sh '''
                        if [ -f pom.xml ]; then
                            sudo mvn clean 
                            sudo mvn clean package
                        fi
                    '''
                }
            }
        }

      stage("SonarQube Analysis"){
        steps {
            dir('java-maven-tomcat-pipeline/java-project/DemoApp') {

                withSonarQubeEnv('my-sonarqube-server') {

                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                        -Dsonar.projectKey=maven-java
                        '''
            }
        }
    }
}

        stage("Sonar Quality Gate"){
            steps {
                timeout(time: 5, unit: "MINUTES") {
                    waitForQualityGate abortPipeline: true
            }
        }
    }




    }
}
